#version 140

// K4's shadow pass on WebGL2, as the override material (render.enable_material) for every model.

in highp vec4 position;

uniform vs_uniforms
{
    highp mat4 mtx_world;
    highp mat4 mtx_viewproj; // the cascade's light view-projection
};

void main()
{
    gl_Position = mtx_viewproj * mtx_world * vec4(position.xyz, 1.0);
}
