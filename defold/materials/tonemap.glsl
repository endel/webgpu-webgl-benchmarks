#ifndef BENCH_TONEMAP_GLSL
#define BENCH_TONEMAP_GLSL

// three.js's ACESFilmicToneMapping (exposure 1) and the sRGB transfer functions.

vec3 RRTAndODTFit(vec3 v)
{
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

vec3 ACESFilmic(vec3 c)
{
    const mat3 IN = mat3(vec3(0.59719, 0.07600, 0.02840), vec3(0.35458, 0.90834, 0.13383), vec3(0.04823, 0.01566, 0.83777));
    const mat3 OUT = mat3(vec3(1.60475, -0.10208, -0.00327), vec3(-0.53108, 1.10813, -0.07276), vec3(-0.07367, -0.00605, 1.07602));
    c *= 1.0 / 0.6;
    return clamp(OUT * RRTAndODTFit(IN * c), 0.0, 1.0);
}

vec3 LinearToSRGB(vec3 c)
{
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

// Defold has no sRGB texture formats, so colour textures are decoded in the shader.
vec3 SRGBToLinear(vec3 c)
{
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

#endif
