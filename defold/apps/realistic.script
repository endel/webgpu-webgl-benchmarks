-- K1 bundle size: glTF + animation + shadows + bloom on the stock engine: the Fox playing its walk
-- on a ground that receives the hand-written cascaded shadows, with the bench render script's bloom.

local function v4(x, y, z, w)
    return vmath.vector4(x, y, z, w or 0)
end

function init(self)
    local eye, target = vmath.vector3(0, 1.5, 3.5), vmath.vector3(0, 0.6, 0)
    local proj = vmath.matrix4_perspective(math.rad(50), 1920 / 1080, 0.1, 100)
    local view = vmath.matrix4_look_at(eye, target, vmath.vector3(0, 1, 0))
    local f = vmath.normalize(target - eye)
    BENCH = {
        version = 1, width = 1920, height = 1080, fov = math.rad(50), near = 0.1, far = 100,
        clear = v4(0.155, 0.155, 0.173, 1), clear_linear = v4(0.02, 0.02, 0.025, 1),
        ambient = v4(0.18, 0.195, 0.225), sun_dir = v4(-0.35, -0.88, -0.26), sun_color = v4(2.2, 2.13, 2.02),
        proj = proj, view = view, frustum = proj * view, cam_pos = v4(eye.x, eye.y, eye.z, 1), cam_fwd = v4(f.x, f.y, f.z),
        shadow = { max_distance = 20, bias = 0.0007, normal_offset = 0.02 },
        bloom = { threshold = 0.85, strength = 0.6, radius = 0.5 },
    }
    go.set_scale(0.02, "fox")
    go.set("ground#model", "base_color", v4(0.55, 0.55, 0.55, 1))
    go.set("ground#model", "pbr", v4(0.9, 0, 0, 0))
    model.play_anim("fox#model", "Walk", go.PLAYBACK_LOOP_FORWARD)
end
